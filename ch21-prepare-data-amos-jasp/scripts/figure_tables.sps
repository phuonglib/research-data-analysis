* Post 21, tables for the figures: the same commands as prepare_sem_data.sps
* with variable names as labels and value labels removed, so the tables stay narrow.
GET FILE='../data/marketplace_x_analysis.sav'.
VARIABLE LABELS CONF1 'CONF1' CONF2 'CONF2' CONF3 'CONF3' CONF4 'CONF4' PV1 'PV1' PV2 'PV2' PV3 'PV3' PV4 'PV4' SAT1 'SAT1' SAT2 'SAT2' SAT3 'SAT3' SAT4 'SAT4' TRU1 'TRU1' TRU2 'TRU2' TRU3 'TRU3' TRU4R 'TRU4R' RI1 'RI1' RI2 'RI2' RI3 'RI3' RI4 'RI4' .
VALUE LABELS CONF1 CONF2 CONF3 CONF4 PV1 PV2 PV3 PV4 SAT1 SAT2 SAT3 SAT4 TRU1 TRU2 TRU3 TRU4R RI1 RI2 RI3 RI4.
DESCRIPTIVES VARIABLES=CONF1 CONF2 CONF3 CONF4 PV1 PV2 PV3 PV4 SAT1 SAT2 SAT3 SAT4 TRU1 TRU2 TRU3 TRU4R RI1 RI2 RI3 RI4 /STATISTICS=MEAN STDDEV MIN MAX.
COUNT N_MISSING = CONF1 CONF2 CONF3 CONF4 PV1 PV2 PV3 PV4 SAT1 SAT2 SAT3 SAT4 TRU1 TRU2 TRU3 TRU4R RI1 RI2 RI3 RI4 (MISSING).
VARIABLE LABELS N_MISSING 'Number of blank items'.
FREQUENCIES N_MISSING /STATISTICS=NONE.
